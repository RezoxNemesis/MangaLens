<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MangaLens" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:paddingBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/widget_translate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minHeight="48dp" android:gravity="center" android:text="Quick Translate" android:textColor="#FF607D" android:textSize="15sp" />
        <TextView android:id="@+id/widget_orez" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minHeight="48dp" android:gravity="center" android:text="Ask OREZ" android:textColor="#FFFFFF" android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/widget_library" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minHeight="48dp" android:gravity="center" android:text="Library" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/widget_downloads" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minHeight="48dp" android:gravity="center" android:text="Downloads" android:textColor="#FFFFFF" android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
