# Keep the portable Clang SSE FP16 kernel change tied to the reviewed upstream bytes.
if(NOT DEFINED WHISPER_SOURCE_DIR)
    message(FATAL_ERROR "WHISPER_SOURCE_DIR is required")
endif()
set(WHISPER_VEC_CPP "${WHISPER_SOURCE_DIR}/ggml/src/ggml-cpu/vec.cpp")
set(WHISPER_VEC_PATCH "${CMAKE_CURRENT_LIST_DIR}/whisper-f16-loop-unroll.patch")
file(SHA256 "${WHISPER_VEC_PATCH}" WHISPER_VEC_PATCH_SHA)
if(NOT WHISPER_VEC_PATCH_SHA STREQUAL "c8e142d7638863ed7f12d8b830e0e0e3afbdbb18b4fbf827e185f5ea6a3faefa")
    message(FATAL_ERROR "Whisper portable FP16 loop patch checksum changed")
endif()
file(SHA256 "${WHISPER_VEC_CPP}" WHISPER_VEC_SOURCE_SHA)
if(WHISPER_VEC_SOURCE_SHA STREQUAL "73a9e796a187556c6e653198c05f41ee67b4d995579f06af701713559fea0723")
    return()
endif()
if(NOT WHISPER_VEC_SOURCE_SHA STREQUAL "7725a5af7d4dc0f9487f1fdd83ba4dd6b0402bf5295d5782f16f6b9a991f9969")
    message(FATAL_ERROR "Whisper FP16 vector source differs from the reviewed a8d002c input")
endif()
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check --whitespace=error-all "${WHISPER_VEC_PATCH}"
    WORKING_DIRECTORY "${WHISPER_SOURCE_DIR}" RESULT_VARIABLE WHISPER_VEC_CHECK_RESULT)
if(NOT WHISPER_VEC_CHECK_RESULT EQUAL 0)
    message(FATAL_ERROR "Whisper portable FP16 loop patch cannot apply cleanly")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" apply --whitespace=error-all "${WHISPER_VEC_PATCH}"
    WORKING_DIRECTORY "${WHISPER_SOURCE_DIR}" RESULT_VARIABLE WHISPER_VEC_PATCH_RESULT)
if(NOT WHISPER_VEC_PATCH_RESULT EQUAL 0)
    message(FATAL_ERROR "Whisper portable FP16 loop patch failed")
endif()
file(SHA256 "${WHISPER_VEC_CPP}" WHISPER_VEC_PATCHED_SHA)
if(NOT WHISPER_VEC_PATCHED_SHA STREQUAL "73a9e796a187556c6e653198c05f41ee67b4d995579f06af701713559fea0723")
    message(FATAL_ERROR "Whisper portable FP16 vector checksum differs from the reviewed output")
endif()
