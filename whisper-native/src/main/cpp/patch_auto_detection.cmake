# Apply one reviewed change to the exact pinned upstream source; fail closed on drift.
if(NOT DEFINED WHISPER_SOURCE_DIR)
    message(FATAL_ERROR "WHISPER_SOURCE_DIR is required")
endif()
set(WHISPER_CPP "${WHISPER_SOURCE_DIR}/src/whisper.cpp")
set(WHISPER_PATCH "${CMAKE_CURRENT_LIST_DIR}/whisper-auto-detection.patch")
file(SHA256 "${WHISPER_PATCH}" WHISPER_PATCH_SHA)
if(NOT WHISPER_PATCH_SHA STREQUAL "611b4f9e64e9a57214f293609d6bcae52aa7c29ba584e78139207af5e6633111")
    message(FATAL_ERROR "Whisper automatic detection patch checksum changed")
endif()
file(SHA256 "${WHISPER_CPP}" WHISPER_SOURCE_SHA)
if(WHISPER_SOURCE_SHA STREQUAL "73dd239fce2fbb57e97ce422e446a2fa16d123148a5e2c05ec5cf6df9df579ea" OR
   WHISPER_SOURCE_SHA STREQUAL "1d51b0a2a731f4b4b1d89d53f2f88cd04fb20b3488aadbb9845ed07c72a9ac39")
    return()
endif()
if(NOT WHISPER_SOURCE_SHA STREQUAL "cf3e1e1d1bd1f91649c946d8f4b87b079fe6f0847cdfbffeaf3239f8a028fc1c")
    message(FATAL_ERROR "Whisper source differs from the reviewed a8d002c cancellation patch input")
endif()
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check "${WHISPER_PATCH}"
    WORKING_DIRECTORY "${WHISPER_SOURCE_DIR}" RESULT_VARIABLE WHISPER_CHECK_RESULT)
if(NOT WHISPER_CHECK_RESULT EQUAL 0)
    message(FATAL_ERROR "Whisper automatic detection patch cannot apply cleanly")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" apply "${WHISPER_PATCH}"
    WORKING_DIRECTORY "${WHISPER_SOURCE_DIR}" RESULT_VARIABLE WHISPER_PATCH_RESULT)
if(NOT WHISPER_PATCH_RESULT EQUAL 0)
    message(FATAL_ERROR "Whisper automatic detection patch failed")
endif()
file(SHA256 "${WHISPER_CPP}" WHISPER_PATCHED_SHA)
if(NOT WHISPER_PATCHED_SHA STREQUAL "73dd239fce2fbb57e97ce422e446a2fa16d123148a5e2c05ec5cf6df9df579ea")
    message(FATAL_ERROR "Whisper patched source checksum differs from the reviewed output")
endif()
